    "skills": [{"category": "string", "items": "string"}],
    "work": [{"company": "string", "role": "string", "date_range": "string", "department": "string", "city": "string", "bullets": ["string"]}],
    "projects": [{"title": "string", "role": "string", "date_range": "string", "tech_stack": "string", "project_url": "string", "bullets": ["string"]}],
    "certificates": [{"title": "string", "authority": "string", "issue_date": "string", "certificate_no": "string", "category": "string", "description": "string"}],
    "competitions": [{"title": "string", "award_level": "string", "award_date": "string", "organization": "string", "rank": "string", "description": "string"}]
  }
}
