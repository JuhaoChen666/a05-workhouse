\geometry{
  left=0.5in,
  right=0.5in,
  top=0.5in,
  bottom=0.5in
}

\setlength{\parindent}{0pt}
\hypersetup{hidelinks}
\setlist{noitemsep, topsep=0.15em, leftmargin=1em}

% 跨平台中文字体自适应回退策略
\IfFontExistsTF{Noto Sans CJK SC}{
  \setCJKmainfont{Noto Sans CJK SC}
}{
