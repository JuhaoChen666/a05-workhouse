% !TEX program = xelatex
\documentclass[11pt,a4paper]{article}

\usepackage{xeCJK}
\usepackage{geometry}
\geometry{left=1.5cm,right=1.5cm,top=1.3cm,bottom=1.3cm}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{tikz}

% 跨平台中文字体自适应回退策略
\IfFontExistsTF{Noto Sans CJK SC}{
  \setCJKmainfont{Noto Sans CJK SC}
}{
  \IfFontExistsTF{PingFang SC}{
    \setCJKmainfont{PingFang SC}
  }{
    \IfFontExistsTF{Microsoft YaHei}{
      \setCJKmainfont{Microsoft YaHei}
    }{
      \setCJKmainfont{SimSun}
    }
  }
}

\pagestyle{empty}

% 节标题格式化
\titleformat{\section}{\large\bfseries}{}{0em}{}[\hrule]
\titlespacing*{\section}{0pt}{1.2ex plus .2ex minus .2ex}{0.8ex plus .1ex}

% 列表紧凑格式
\setlist[itemize]{leftmargin=1.5em, itemsep=0.15ex, topsep=0.2ex, parsep=0ex}

\newcommand{\datedline}[2]{
  \noindent \textbf{ #1 } \hfill #2 \par
}

\begin{document}

{% if options.show_avatar and basic_info.avatar_path %}
% 证件照插槽：TikZ 绝对定位，右上角悬浮
\begin{tikzpicture}[remember picture, overlay]
  \node[anchor=north east, xshift=-1.5cm, yshift=-1.2cm] at (current page.north east) {
    \includegraphics[height=2.6cm]{ {{ basic_info.avatar_path }} }
  };
\end{tikzpicture}
{% endif %}

% ==================== 个人信息 Header ====================
\begin{center}
  {\LARGE \textbf{ {{ basic_info.name | latex_escape }} }} \\
  \vspace{0.4ex}
  {% if basic_info.title %}
  {\small 求职意向: {{ basic_info.title | latex_escape }} } \\
  \vspace{0.4ex}
  {% endif %}
  {\small
    电话: {{ basic_info.phone | latex_escape }} \quad
    {% if basic_info.email %}邮箱: \href{mailto:{{ basic_info.email }}}{ {{ basic_info.email | latex_escape }} } \quad {% endif %}
    {% if basic_info.github %}GitHub: \href{https://github.com/{{ basic_info.github }}}{ {{ basic_info.github | latex_escape }} } \quad {% endif %}
    {% if basic_info.city %}城市: {{ basic_info.city | latex_escape }}{% endif %}
  }
\end{center}

% ==================== 教育背景 ====================
{% if education %}
\section{教育背景}
{% for edu in education %}
\datedline{ {{ edu.school | latex_escape }} \quad {{ edu.major | latex_escape }} \quad ({{ edu.degree | latex_escape }}) }{ {{ edu.date_range | latex_escape }} }
{% endfor %}
{% endif %}

% ==================== 专业技能 ====================
{% if skills %}
\section{专业技能}
\begin{itemize}
  {% for s in skills %}
  \item \textbf{ {{ s.category | latex_escape }} }: {{ (s['items'] if 'items' in s else (s.skills | join('、') if s.skills is defined else s.items)) | latex_escape }}
  {% endfor %}
\end{itemize}
{% endif %}

% ==================== 工作与实习经历 ====================
{% if work %}
\section{工作经历}
{% for item in work %}
\datedline{ {{ item.company | latex_escape }} \hfill \textnormal{ {{ item.role | latex_escape }} } }{ {{ item.date_range | latex_escape }} }
{% if item.bullets %}
\begin{itemize}
  {% for b in item.bullets %}
  \item {{ b | latex_escape }}
  {% endfor %}
\end{itemize}
{% endif %}
\vspace{0.3ex}
{% endfor %}
{% endif %}

% ==================== 核心项目经历 ====================
{% if projects %}
\section{项目经历}
{% for proj in projects %}
\datedline{ {{ proj.title | latex_escape }} \hfill \textnormal{ {{ proj.role | latex_escape }} } }{ {{ proj.date_range | latex_escape }} }
{% if proj.tech_stack %}
\noindent {\footnotesize \textbf{技术栈}: {{ proj.tech_stack | latex_escape }} {% if proj.project_url %}\hfill \href{ {{ proj.project_url }} }{[项目代码]}{% endif %} } \par
{% endif %}
{% if proj.bullets %}
\begin{itemize}
  {% for b in proj.bullets %}
  \item {{ b | latex_escape }}
  {% endfor %}
\end{itemize}
{% endif %}
\vspace{0.3ex}
{% endfor %}
{% endif %}

% ==================== 比赛获奖与荣誉 ====================
{% if competitions %}
\section{比赛获奖与荣誉}
{% for comp in competitions %}
\datedline{ {{ comp.title | latex_escape }} \quad \textnormal{ {{ comp.award_level | latex_escape }} } }{ {{ comp.award_date | latex_escape }} }
{% endfor %}
{% endif %}

% ==================== 证书与知识产权 ====================
{% if certificates %}
\section{证书与知识产权}
{% for cert in certificates %}
\datedline{ {{ cert.title | latex_escape }} \quad {% if cert.category %}\textnormal{({{ cert.category | latex_escape }})}{% endif %} }{ {{ cert.issue_date | latex_escape }} }
{% endfor %}
{% endif %}

\end{document}
