# ============================================
# Emo2Vec-Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# ============================================
# 应用基础配置
# ============================================
APP_NAME=Emo2Vec-Agent
APP_VERSION=0.1.0
APP_DEBUG=false
APP_ENV=development

# API 配置
API_V1_PREFIX=/api/v1
API_TITLE=Emo2Vec Agent API
API_DESCRIPTION=FastAPI + LangChain AI Agent API

# CORS 配置
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============================================
# 服务器配置
# ============================================
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# ============================================
# DeepSeek LLM 配置
# ============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT=60

# ============================================
# ModelScope 配置
# ============================================
MODELSCOPE_CACHE_DIR=./cache/modelscope
MODELSCOPE_DEVICE=auto

# 情感分析模型 (示例)
EMOTION_MODEL=damo/nlp_structbert_emotion-classification_chinese-base

# 语音识别模型 (示例)
ASR_MODEL=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch

# ============================================
# 嵌入模型配置
# ============================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ============================================
# 向量数据库配置 (Chroma)
# ============================================
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=emo2vec_knowledge

# 向量数据库配置 (Milvus - 可选)
# VECTOR_STORE_TYPE=milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION=emo2vec_knowledge

# ============================================
# Redis 缓存配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# 缓存过期时间 (秒)
CACHE_TTL=3600
SESSION_TTL=86400

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/emo2vec
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# SQLite (开发环境)
# DATABASE_URL=sqlite+aiosqlite:///./data/emo2vec.db

# ============================================
# 消息队列配置 (Celery)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ============================================
# 文件存储配置 (MinIO)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=emo2vec-files
MINIO_SECURE=false

# ============================================
# LangSmith 监控配置 (可选)
# ============================================
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=emo2vec-agent
LANGSMITH_TRACING=true

# ============================================
# 安全配置
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# 速率限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/emo2vec.log
